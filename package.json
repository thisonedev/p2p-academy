{
  "name": "p2p-academy",
  "version": "0.5.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm --parallel --filter @academy/ui --filter @academy/courses --filter @p2p-academy/web dev",
    "dev:webpack": "pnpm --filter @p2p-academy/web dev:webpack",
    "dev:clean": "pnpm --filter @p2p-academy/web dev:clean",
    "build": "pnpm build:packages && pnpm --filter @p2p-academy/web build",
    "start": "pnpm --filter @p2p-academy/web start",
    "start:web": "pnpm --filter @p2p-academy/web start",
    "lint": "pnpm --filter @p2p-academy/web lint",
    "check": "pnpm --filter @p2p-academy/web check",
    "check:write": "pnpm --filter @p2p-academy/web check:write",
    "format": "pnpm --filter @p2p-academy/web format",
    "format:check": "pnpm --filter @p2p-academy/web format:check",
    "typecheck": "pnpm --filter @p2p-academy/desktop typecheck && pnpm --filter @academy/constants --filter @academy/core --filter @academy/courses --filter @academy/sandbox-types --filter @academy/ui --filter @academy/validation --filter @p2p-academy/web exec tsc --noEmit -p tsconfig.json",
    "prepare:husky": "husky",
    "sync:examples": "pnpm --filter @academy/courses sync:examples",
    "sync:examples:check": "pnpm --filter @academy/courses sync:examples:check",
    "lessons:check": "pnpm --filter @academy/courses lessons:check",
    "lessons:check:quick": "pnpm --filter @academy/courses lessons:check:quick",
    "verify:tests": "pnpm --filter @academy/courses verify:tests",
    "verify:tests:check": "pnpm --filter @academy/courses verify:tests:check",
    "check:yaml": "pnpm --filter @academy/courses check:yaml",
    "check:examples": "pnpm --filter @academy/courses check:examples",
    "knip": "knip",
    "check:constants": "pnpm --filter @academy/constants test",
    "check:colors": "node packages/ui/scripts/check-colors.mjs",
    "api:check": "node scripts/api-baselines.mjs",
    "api:update": "node scripts/api-baselines.mjs --update",
    "notice": "node scripts/notice.mjs",
    "notice:check": "node scripts/notice.mjs --check",
    "docs:lint": "node scripts/docs-lint.mjs",
    "release": "node scripts/release.mjs",
    "generate-scorm": "node packages/scorm/scripts/build.mjs",
    "dev:desktop": "pnpm --filter @p2p-academy/desktop dev",
    "start:desktop": "pnpm --filter @p2p-academy/desktop start",
    "ipc:contract": "pnpm --filter @p2p-academy/desktop ipc:contract",
    "ipc:contract:check": "pnpm --filter @p2p-academy/desktop ipc:contract:check",
    "capture:desktop": "pnpm --filter @p2p-academy/desktop capture",
    "cli": "node apps/cli/bin/p2p-academy.js"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "knip": "6.41.0",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ],
    "overrides": {
      "dompurify@<3.4.16": "^3.4.16",
      "postcss@<8.5.23": "^8.5.23"
    }
  }
}
