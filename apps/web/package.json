{
  "name": "@p2p-academy/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-monaco.mjs",
    "dev": "node scripts/dev-port.mjs && next dev --turbopack --port 3000",
    "predev:webpack": "node scripts/copy-monaco.mjs",
    "dev:webpack": "node scripts/dev-port.mjs && next dev --port 3000",
    "dev:clean": "node scripts/copy-monaco.mjs && node ../../packages/courses/scripts/dev-clean.mjs && node scripts/dev-port.mjs && next dev --turbopack --port 3000",
    "prebuild": "node scripts/copy-monaco.mjs && node scripts/copy-install-sh.mjs && pnpm -w run build:packages && pnpm -w run check:constants && pnpm -w run check:yaml && pnpm -w run verify:tests:check && pnpm lint && pnpm check",
    "build": "next build",
    "build:dev": "next build",
    "start": "BASE_PATH=/p2p-academy node serve.mjs",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@academy/config": "workspace:*",
    "@academy/constants": "workspace:*",
    "@academy/core": "workspace:*",
    "@academy/courses": "workspace:*",
    "@academy/ui": "workspace:*",
    "@academy/validation": "workspace:*",
    "fumadocs-core": "^15.0.0",
    "fumadocs-mdx": "13.0.0",
    "fumadocs-ui": "^15.0.0",
    "lucide-react": "^0.469.0",
    "monaco-editor": "^0.56.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/mdx": "^2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
