{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "workers/**/*.cjs",
    "workers/types.d.ts",
    "electron/**/*.js",
    "electron/**/*.cjs",
    "shared/**/*.cjs",
    "runner.cjs"
  ]
}
